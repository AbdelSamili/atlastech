# HubSpot form embed
# ------------------
# Copy this file to `.env.local` (local development) and fill in the values
# taken from the HubSpot embed code. For the GitHub Pages build, add the same
# names as repository *Variables* (Settings > Secrets and variables > Actions > Variables).
#
# While VITE_HUBSPOT_PORTAL_ID or VITE_HUBSPOT_FORM_ID is empty, the site shows
# a demonstration form that sends no data anywhere.

# Data center region shown in the embed code: na1, na2, eu1, ap1...
VITE_HUBSPOT_REGION=eu1

# The number in the embed code (portalId / data-portal-id), e.g. 12345678
VITE_HUBSPOT_PORTAL_ID=

# The form GUID (formId / data-form-id), e.g. 1a2b3c4d-1234-5678-9abc-0123456789ab
VITE_HUBSPOT_FORM_ID=

# Which kind of embed code HubSpot gave you:
#   v2    -> code containing  hbspt.forms.create({ region, portalId, formId })
#            (form renders in the page, so the site CSS styles it)
#   frame -> code containing  <div class="hs-form-frame" data-region=... data-form-id=... data-portal-id=...>
#            (new form editor; form renders in an iframe, style it in HubSpot)
VITE_HUBSPOT_EMBED_MODE=v2
