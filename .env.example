# HubSpot form embed
# ------------------
# Copy this file to `.env` (local development) and fill in the values from the
# HubSpot embed code:
#
#   <script src="https://js-eu1.hsforms.net/forms/embed/<PORTAL_ID>.js" defer></script>
#   <div class="hs-form-frame" data-region="eu1" data-form-id="<FORM_ID>" data-portal-id="<PORTAL_ID>"></div>
#
# For the live site, add the same names to the Vercel project
# (Settings > Environment Variables) and redeploy: Vite injects them at build time.
#
# While any of the three values is empty, the site shows a demonstration form
# that sends no data anywhere.

# data-region, e.g. eu1
VITE_HUBSPOT_REGION=

# data-portal-id, e.g. 12345678
VITE_HUBSPOT_PORTAL_ID=

# data-form-id, e.g. 1a2b3c4d-1234-5678-9abc-0123456789ab
VITE_HUBSPOT_FORM_ID=
